<?xml version="1.0" encoding="utf-8"?>
<!--
  The standalone phone sync bridge is deliberately reached at a user-entered
  private-LAN address such as http://192.168.1.20:4178. Android's network
  security policy cannot express RFC1918 subnets dynamically, so cleartext is
  enabled here and the application enforces the narrower boundary in
  normalizeSyncBaseUrl(): HTTP is accepted only for loopback/private/link-local
  hosts, while public addresses require HTTPS. The main hosted LPS server has a
  separate validator and requires HTTPS unless it is the USB/loopback endpoint.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
