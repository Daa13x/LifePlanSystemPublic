{
  "manifest_version": 3,
  "name": "Life Planner Browser Agent",
  "version": "0.1.1",
  "description": "Lets local Life Planner send browser-agent questions through the user's Chrome tabs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Life Planner Browser Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:4177/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://auth.openai.com/*",
    "https://gemini.google.com/*",
    "https://accounts.google.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
