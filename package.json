{
  "name": "life-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first Life Planner personal assistant MVP.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-git-hooks.mjs",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/write-build-info.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.js",
    "check": "npm run verify:navigation-consolidation && npm run verify:chat-capabilities && npm run build",
    "verify:navigation-consolidation": "node scripts/verify-navigation-consolidation.mjs",
    "verify:chat-capabilities": "node scripts/verify-chat-capabilities.mjs",
    "policy:cloud-main": "node scripts/check-cloud-main.mjs",
    "verify:maintainer-attribution": "node scripts/verify-maintainer-attribution.mjs",
    "verify:executor-enforcement": "node scripts/verify-executor-enforcement.mjs",
    "verify:openhands-invocation-adapter": "node scripts/verify-openhands-invocation-adapter.mjs",
    "verify:openhands-invocation-schemas": "node scripts/verify-openhands-invocation-schemas.mjs",
    "verify:openhands-invocation-all": "npm run verify:openhands-invocation-adapter && npm run verify:openhands-invocation-schemas",
    "verify:runcli-cwd": "node scripts/verify-runcli-cwd.mjs",
    "verify:source-control-safety": "node scripts/verify-source-control-safety.mjs",
    "verify:source-control-api": "node scripts/verify-source-control-api.mjs",
    "verify:git-authority-policy": "node scripts/verify-git-authority-policy.mjs",
    "verify:governance-safety": "node scripts/verify-governance-safety.mjs",
    "verify:browser-connector-safety": "node scripts/verify-browser-connector-safety.mjs",
    "verify:browser-extension-install": "node scripts/verify-browser-extension-install.mjs",
    "verify:tray-launcher": "node scripts/verify-tray-launcher.mjs",
    "verify:portable-package": "node scripts/verify-portable-package.mjs",
    "verify:openhands-stop-boundary": "node scripts/verify-openhands-stop-boundary.mjs",
    "verify:local-ai-docs": "node scripts/verify-local-ai-docs.mjs",
    "verify:native-coding-worker": "node scripts/verify-native-coding-worker.mjs",
    "verify:browser-assisted-coding": "node scripts/verify-browser-assisted-coding.mjs",
    "verify:runtime-safety": "npm run verify:maintainer-attribution && npm run verify:runcli-cwd && npm run verify:source-control-safety && npm run verify:source-control-api && npm run verify:git-authority-policy && npm run verify:governance-safety && npm run verify:browser-connector-safety && npm run verify:browser-extension-install && npm run verify:tray-launcher && npm run verify:executor-enforcement && npm run verify:openhands-invocation-all && npm run verify:openhands-stop-boundary && npm run verify:local-ai-docs && npm run verify:native-coding-worker && npm run verify:browser-assisted-coding && npm run verify:mutation-csrf && npm run verify:durable-confirmations && npm run verify:setup-recovery && npm run verify:setup-recovery-http && npm run verify:setup-recovery-ui",
    "verify:lifeskillsystem-skills": "node scripts/verify-lifeskillsystem-skills.mjs",
    "verify:local-learning-event-schema": "node scripts/verify-local-learning-event-schema.mjs",
    "verify:local-learning-event-validator": "node scripts/verify-local-learning-event-validator.mjs",
    "verify:local-learning-event-writer": "node scripts/verify-local-learning-event-writer.mjs",
    "verify:local-learning-review-inbox-reader": "node scripts/verify-local-learning-review-inbox-reader.mjs",
    "verify:legacy-message-display": "node scripts/verify-legacy-message-display.mjs",
    "verify:mutation-csrf": "node scripts/verify-mutation-csrf.mjs",
    "verify:durable-confirmations": "node scripts/verify-durable-confirmations.mjs",
    "verify:setup-recovery": "node scripts/verify-setup-recovery.mjs",
    "verify:setup-recovery-http": "node scripts/verify-setup-recovery-http.mjs",
    "verify:setup-recovery-ui": "node scripts/verify-setup-recovery-ui.mjs",
    "verify:chat-behavior": "node scripts/verify-chat-behavior.mjs",
    "verify:local-knowledge-memory": "node scripts/verify-local-knowledge-memory.mjs",
    "verify:personal-knowledge-coverage": "node scripts/verify-personal-knowledge-coverage.mjs",
    "verify:installed-chat": "node scripts/verify-installed-chat.mjs",
    "verify:windows-path-open": "node scripts/verify-windows-path-open.mjs",
    "verify:extension-icons": "node scripts/verify-extension-icons.mjs",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package:inno": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1 && ISCC.exe installer/LifePlannerPortable.iss",
    "verify:installer-safety": "node scripts/verify-installer-safety.mjs",
    "verify:build-provenance": "node scripts/verify-build-provenance.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "4.22.2",
    "lucide-react": "^0.468.0",
    "marked": "^14.1.4",
    "pdfjs-dist": "^6.1.200",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "9.2.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "shell-quote": "1.10.0"
  }
}
