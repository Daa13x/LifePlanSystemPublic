# Copy this to /opt/lps/lps-beta.env (NOT committed to git -- chmod 600, owned by the lps user)
# and fill in real values before starting the service.

# Turns on per-user accounts/auth and multi-tenant data isolation.
# Never set this for a plain desktop/adb-reverse install.
LIFE_PLANNER_MULTI_USER=1

# Bind to localhost only -- Caddy reverse-proxies to this from the outside.
# Never set this to 0.0.0.0; the Express app itself must not be reachable
# directly from the internet (see deploy/Caddyfile and the firewall rules
# in deploy/DEPLOY.md).
LIFE_PLANNER_HOST=127.0.0.1
LIFE_PLANNER_PORT=4177

# REQUIRED for a genuinely CLOSED beta: without this, registration is open
# to anyone who finds the server's URL. Generate one with:
#   openssl rand -hex 16
# and share it privately with only the specific people you invite.
LIFE_PLANNER_BETA_INVITE_CODE=

# Persistent SQLite database file. Must live under a directory the `lps`
# service user owns and that survives redeploys (never inside the git
# checkout's working tree, which a redeploy may `git clean`).
LIFE_PLANNER_DB=/opt/lps/data/life-planner.sqlite
